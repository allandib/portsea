---
/**
 * The home page: one section after another, each fed its words from
 * src/data/home.ts. Reorder the sections, leave out the ones the copy has no
 * words for, or use a kind twice with different words (each needs its own
 * id). The header's links and the button point at these ids.
 */
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Checklist from '../components/Checklist.astro';
import Cta from '../components/Cta.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Faq from '../components/Faq.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import TextBlock from '../components/TextBlock.astro';
import { CONTACT, ENQUIRY, FORMS, SITE } from '../data/site';
import { CONTACT_SECTION, DOMAIN, FAQS, GIFT_CTA, PHOTOS, PLATE, SELLER } from '../data/home';

const hasForm = Boolean(FORMS.contact);
const formNote = `${CONTACT_SECTION.note} Prefer email? Write to <a href="mailto:${CONTACT.email}">${CONTACT.email}</a>.`;
const title = 'Portsea’s postcode is for sale: Heritage plate 3944 and portsea.com.au';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<Base title={title} description={SITE.description} path="/" jsonLd={jsonLd} hasForm={hasForm}>
  <Hero />
  <Checklist id="plate" title={PLATE.title} paragraphs={PLATE.paragraphs} lead={PLATE.lead} items={PLATE.items} />
  <Gallery label="Close-ups of the certificate and the book" photos={PHOTOS} />
  <TextBlock id="about" title={SELLER.title} paragraphs={SELLER.paragraphs} />
  <Cta heading={GIFT_CTA} note="" class="pt-4 pb-16 sm:pb-20" />
  <Band>
    <TextBlock id="domain" eyebrow={DOMAIN.eyebrow} title={DOMAIN.title} large paragraphs={DOMAIN.paragraphs} />
  </Band>
  <Faq id="faqs" title={FAQS.title} items={FAQS.items} />

  <section id="contact" class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-20">
    <h2 class="heading-2">{CONTACT_SECTION.title}</h2>
    {
      ENQUIRY.action ? (
        <EnquiryForm lead={CONTACT_SECTION.lead} note={formNote} suffix="home" split />
      ) : hasForm ? (
        <LeadForm lead={CONTACT_SECTION.lead} suffix="home" split />
      ) : (
        <div class="mt-6 max-w-[42rem]">
          <p class="font-body text-[1.1875rem] leading-relaxed">{CONTACT_SECTION.lead}</p>
          <p class="mt-6">
            <a href={`mailto:${CONTACT.email}`} class="btn btn-primary btn-lg">
              {CONTACT.email}
            </a>
          </p>
        </div>
      )
    }
  </section>
</Base>
