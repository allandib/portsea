---
/**
 * A row of photographs with a caption under each: close-ups that back up the
 * section above them. Two or three side by side on wide screens, one under the
 * other on phones. They load as the visitor scrolls to them.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string;
  /** Names the row for screen readers, e.g. "Close-ups of the plate". */
  label: string;
  photos: readonly { image: ImageMetadata; alt: string; caption?: string }[];
}
const { id, label, photos } = Astro.props;
const columns = photos.length >= 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

<section id={id} aria-label={label} class="mx-auto max-w-6xl px-5 pb-12 sm:px-8 sm:pb-20">
  <ul role="list" class:list={['grid max-w-4xl gap-6', columns]}>
    {
      photos.map((photo) => (
        <li>
          <figure>
            <Image src={photo.image} alt={photo.alt} widths={[320, 640]} sizes="(min-width: 640px) 28rem, 100vw" class="aspect-square w-full rounded-xl object-cover" />
            {photo.caption && <figcaption class="mt-3 font-body text-[0.9375rem] leading-relaxed text-muted">{photo.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
</section>
