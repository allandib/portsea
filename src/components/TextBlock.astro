---
/**
 * A heading over paragraphs, in a column capped at about 65 characters.
 * `eyebrow` puts a short label above the heading; `large` sets the heading at
 * the size of the page's headline, for a name or a short statement.
 */
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  large?: boolean;
  paragraphs: readonly string[];
}
const { id, eyebrow, title, large = false, paragraphs } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-20">
  <div class="max-w-[42rem]">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class:list={[large ? 'heading-1' : 'heading-2', eyebrow && 'mt-4']}>{title}</h2>
    <div class:list={['copy space-y-5 font-body text-[1.0625rem] leading-relaxed sm:text-[1.1875rem]', large ? 'mt-8' : 'mt-6']}>
      {paragraphs.map((p) => <p set:html={p} />)}
    </div>
  </div>
</section>
